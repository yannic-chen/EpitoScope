normalize_df <- function(df) {
#Here we transform the data to only contain the minimum columns required for analysis and rename column names to work with code.
# The columns we need are:
#                    Peptide Sequence
#                    Some quantification like area or intensity. This will need to be calculated from sample specific columns.
#                    Some type of Score (i.e,. X10LgP or Probability)
#                    Charge
#                    Mass
#                    m/z <- this be calculated manually
#                    RT
#                    ppm (or some other uncertainty measurement)
#                    Protein names/Accession
#                    length <- this can be calculated manually.
#                    We also need to identify the sample specific columns.
# To unify columns, I make them all capitalized
original <- data.frame(
final_name = character(),
original_name = character(),
stringsAsFactors = FALSE
)
res <- find_transform_column(df, c("peptide", "sequence"), "PEPTIDE") #Fragpipe combined_peptide.tsv uses "Sequence" Column without modifications. It has a separate assigned Modification column.
df <- res$df
df$STRIPPED <- remove_ptms(df$PEPTIDE)
original <- log_rename(original, res, "PEPTIDE")
res <- find_transform_column(df, c("X.10LgP", "Probability", "Score"), "SCORE")
df <- res$df
original <- log_rename(original, res, "SCORE")
res <- find_transform_column(df, c("Charge", "z"), "CHARGE")
df <- res$df
original <- log_rename(original, res, "CHARGE")
res <- find_transform_column(df, c("Mass"), "MASS") #No Mass column in combined_peptide.tsv
df <- res$df
original <- log_rename(original, res, "MASS")
res <- find_transform_column(df, c("RT"), "RT") #No RT column in combined_peptide.tsv
df <- res$df
original <- log_rename(original, res, "RT")
res <- find_transform_column(df, c("ppm"), "PPM") #No Rppm column in combined_peptide.tsv
df <- res$df
original <- log_rename(original, res, "PPM")
res <- find_transform_column(df, c("Accession", "Protein ID"), "PROTEIN") #In FragPipe it has Gene, Protein and Protein ID columns.
df <- res$df
original <- log_rename(original, res, "PROTEIN")
#Length. If we cannot find a column, calculte from peptide column
res <- find_transform_column(df, c("length"), "LENGTH") #Fragpipe Combined_peptide.tsv doesnt have length colummn. We need to calculate manually.
if (!is.null(res$matched_column)) {
df <- res$df
original <- log_rename(original, res, "LENGTH")
} else {
df$LENGTH <- nchar(df$STRIPPED)
original <- rbind(original, data.frame(final_name="LENGTH", original_name="calculated", stringsAsFactors=FALSE))
}
#Area/Intensity
sample  <- which(startsWith(tolower(colnames(df)), "area")) #Perhaps I need to rewrite this for FragPipe.
if (length(sample) == 0) {
sample  <- which(startsWith(tolower(colnames(df)), "intensity")) #In FragPipe we have "exp# Intensity"
if (length(sample) == 0) {
stop("No Area or Intensity columns")
} else {
original <- bind_rows(original, data.frame(final_name="QUANTITY_INTENSITY", original_name=list(colnames(df[,sample]))))
}
} else {
original <- bind_rows(original, data.frame(final_name="QUANTITY_AREA", original_name=list(colnames(df[,sample]))))
}
df$MAX_QUANTITY <- apply(df[, sample], 1, function(x) {
if (all(is.na(x))) {
NA
} else {
max(x, na.rm = TRUE)
}
})
#We need another column to know how many samples the peptide was found in.
spec <- grep("spec", tolower(colnames(df))) #In PEAKS these start with X.Spec. In Fragpipe combined_peptide.tsv we have "exp# Spectral Count"
spec <- spec[colnames(df)[spec] != "X.Spec"] #This column in PEAKS 11 Online sums all Spectra found by all samples, but not how many samples found the peptide. One sample can find the peptide multiple times.
if (length(spec) == 0) {
stop("No Spectra column")
} else {
original <- bind_rows(original, data.frame(final_name="SPECTRA", original_name=list(colnames(df[, spec])), stringsAsFactors=FALSE))
}
#Only keep cols that were found
keep_cols <- original %>%
filter(!is.na(original_name)) %>%
filter(purrr::map_lgl(final_name, ~ is.character(.x) && length(.x) == 1)) %>% #This removes entries where the original column names are a list of strings. These are added separately.
pull(final_name)
keep_cols <- c(keep_cols, colnames(df)[sample],colnames(df)[spec], "STRIPPED", "MAX_QUANTITY")
#Now we can prepare the summary table since we have the columns to keep.
original <- original %>% mutate(coalesced = do.call(coalesce, across(-1))) %>% select(1, coalesced) %>% group_by(final_name) %>% summarise(coalesced_list = list(coalesced), .groups = "drop")
return(list(df = df[,unique(keep_cols)], table = original))
}
log_rename <- function(log_df, res, new_name) {
rbind(log_df,
data.frame(final_name = new_name,
original_name = res$matched_column,
stringsAsFactors = FALSE))
}
#-----------helper function in global.R------------------
find_transform_column <- function(df, list, name) {
# Match independent of capitalization
match <- which(tolower(colnames(df)) %in% tolower(list))
if (length(match) == 1) {
original_name <- colnames(df)[match]
colnames(df)[match] <- name
} else if (length(match) > 1) {
stop("Multiple columns detected: ",
paste(colnames(df)[match], collapse = ", "))
} else {
# No match found
original_name <- NA
}
return(list(
df = df,
matched_column = original_name
))
}
